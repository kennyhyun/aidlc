{
  "name": "aidlc",
  "version": "1.0.0",
  "description": "AI-driven development life cycle",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest test/ --coverage",
    "test:watch": "jest test/ --watch"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.spec.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git@gitlab.imaginetoolbox.com:whitech-group/development/reimagine/aidlc.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@slack/bolt": "^4.6.0",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^5.0.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.7.4",
    "js-yaml": "^4.1.1",
    "lodash.debounce": "^4.0.8",
    "node-telegram-bot-api": "^0.67.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "strip-ansi": "^7.1.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11"
  }
}
